# Configuration reference: https://editorconfig.org (restart the editor after changes).

## Mark this file as the EditorConfig root.
root = true

## Apply to all files.
[*]
### Character encoding.
charset = utf-8
### Indentation style: space | tab; prefer spaces.
indent_style = space
### Spaces per indentation level.
indent_size = 2
### Line endings: lf | cr | crlf; normally use lf.
end_of_line = lf
### Ensure a final newline.
insert_final_newline = true
### Remove trailing whitespace.
trim_trailing_whitespace = true

## Apply to Markdown files.
[*.md]
insert_final_newline = false
trim_trailing_whitespace = false
