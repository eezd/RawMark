    "happy-dom": "21.0.3",
    "sass-embedded": "1.78.0",
    "typescript": "6.0.3",
    "unocss": "66.7.5",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
