{
  "name": "rawmark-web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo --base /RawMark/ --outDir dist-demo",
    "preview": "vite preview",
    "lint": "eslint --fix",
