    "@codemirror/view": "6.43.14",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "axios": "1.18.1",
    "element-plus": "2.14.2",
    "gemoji": "8.1.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.11",
    "mermaid": "12.2.0",
    "pinia": "3.0.4",
    "turndown": "7.2.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.1.0",
