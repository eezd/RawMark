# Trusted tools only: source/control Git trees are copied after container creation.
FROM golang:1.27.2-bookworm AS go
FROM node:24.22.3-bookworm
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" GOTOOLCHAIN=local
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@12.11.2 \
    && test "$(pnpm --version)" = '12.11.2' \
    && go version | grep 'go1.27.2 ' \
    && node --version | grep '^v24\.' \
    && mkdir -p /work /control /home/candidate \
    && chown 10001:10001 /work /home/candidate
USER 10001:10001
WORKDIR /work
